# --- 사이트 (1단계 SSG) ---
# 도메인 확정 시 교체 (미설정이면 vercel.app 기본값)
NEXT_PUBLIC_SITE_URL="https://dndn.vercel.app"
# 도메인 연결 후 "true" 로 바꿔 색인 허용 (기본: noindex — BUILD_BRIEF)
NEXT_PUBLIC_INDEXABLE="false"
# GA4 측정 ID (F-15) — 미설정이면 이벤트 no-op
NEXT_PUBLIC_GA_ID=""

# --- 제도 개정 모니터링 (tools/monitor — W1) ---
# TypeSafe(Jev) 분류용 — 없으면 모니터는 미분류 모드로 동작 (fail-closed)
TYPESAFE_API_KEY=""

# --- Supabase (2단계 대비 휴면 — Dashboard → Connect 에서 복사) ---
# DATABASE_URL: Transaction pooler(6543) — 런타임(Vercel 서버리스)용. pgbouncer 파라미터 필수.
# DIRECT_URL:   Session pooler(5432) — prisma migrate 등 CLI 전용(트랜잭션 풀러로는 마이그레이션 불가).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
